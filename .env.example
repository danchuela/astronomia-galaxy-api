# Copy this file to .env and set OPENAI_API_KEY. Set API_KEY if authentication is enabled.
# .env is ignored by git.

# HTTP API. API_KEY is optional when REQUIRE_API_KEY=false.
API_KEY=change-me
REQUIRE_API_KEY=false
ARTIFACT_DIR=artifacts
LOG_LEVEL=INFO

# LangSmith tracing, optional.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# OpenAI, required for natural-language parsing and the analysis agent.
OPENAI_API_KEY=
# Model used by the LangGraph analysis agent (tool-calling).
AGENT_MODEL=gpt-6-luna
# Model used by the NLU parser (enrich_request).
OPENAI_PARSE_MODEL=gpt-6-luna
# Model used for narrative summary generation.
OPENAI_MODEL=gpt-6-luna

# Timeouts, in seconds.
# SKYVIEW_TIMEOUT=240
# SESAME_TIMEOUT=60
# SIMBAD_TIMEOUT=15
